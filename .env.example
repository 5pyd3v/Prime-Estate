APP_NAME="Real Estate CMS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=change-this-to-a-random-32-char-secret

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=realestate_cms
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_NAME=recms_session
SESSION_LIFETIME=7200

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="Real Estate CMS"

UPLOAD_MAX_SIZE=8388608
